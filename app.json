{
  "expo": {
    "name": "ReadyDar",
    "slug": "darclean-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "darclean",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.darclean.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 33
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.darclean.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ReadyDar records where cleaning-report photos are taken, so the report shows they were taken at the property.",
        "NSCameraUsageDescription": "ReadyDar uses your camera to take cleaning-report photos, photos of your property and its door, and photos you send to guests.",
        "NSPhotoLibraryUsageDescription": "ReadyDar lets you choose photos of your property, its door, and photos to send to guests.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#033E35"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ReadyDar records where cleaning-report photos are taken, so the report shows they were taken at the property.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReadyDar lets you choose photos of your property, its door, and photos to send to guests.",
          "cameraPermission": "ReadyDar uses your camera to take cleaning-report photos, photos of your property and its door, and photos you send to guests.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF7"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1",
      "webUrl": "http://localhost:3000",
      "router": {},
      "eas": {
        "projectId": "7b35d5dd-3653-440d-9c82-af6494e839cf"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7b35d5dd-3653-440d-9c82-af6494e839cf"
    }
  }
}
