# Point this at your running DarClean API.
# For a physical device or emulator, "localhost" will NOT work — use your
# computer's LAN IP instead, e.g. http://192.168.1.42:4000/api/v1
# (Find it with `ipconfig` on Windows, look for "IPv4 Address").
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Point this at your running DarClean web app (apps/web) — used to build the
# guest-facing online check-in link that gets shared via WhatsApp. Same
# LAN-IP caveat as above applies for physical devices.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
